<div id="drill_stats" class="bg-white rounded-lg shadow p-4 flex gap-4 text-sm">
  <div class="text-center">
    <div class="font-bold text-green-600"><%= stats.correct %></div>
    <div class="text-gray-600">Correct</div>
  </div>
  <div class="text-center">
    <div class="font-bold text-red-600"><%= stats.incorrect %></div>
    <div class="text-gray-600">Incorrect</div>
  </div>
  <div class="text-center">
    <div class="font-bold text-gray-600"><%= stats.passed %></div>
    <div class="text-gray-600">Passed</div>
  </div>
  <div class="text-center">
    <div class="font-bold text-blue-600"><%= stats.seen %></div>
    <div class="text-gray-600">Seen</div>
  </div>
</div>
